NODE_ENV=production
ALLOW_LOCAL_FALLBACK=false
TELEGRAM_BOT_TOKEN=
BOT_MODE=polling
WEBHOOK_URL=
WEBHOOK_SECRET=
ADMIN_IDS=
OWNER_TELEGRAM_ID=
STORE_SUPPORT_USERNAME=quizystars_support
STORE_NAME=QuizyStars
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Buyer Payment Providers (CryptoBot 3%, xRocket 2%; Telegram Stars XTR checkout DISABLED)
CRYPTOBOT_API_TOKEN=
CRYPTOBOT_API_URL=https://pay.crypt.bot/api
# xRocket Pay REST API v1 (Production: https://pay.api.xrocket.exchange | Testnet: https://pay.api.testnet.xrocket.exchange)
XROCKET_API_KEY=
XROCKET_API_URL=https://pay.api.xrocket.exchange

# MyStars FaaS v1 Supplier Integration — Polling-Only Mode (Official REST API: https://api.mystars.tg/v1)
MYSTARS_PAYMENT_CURRENCY=usdt_ton
MYSTARS_API_BASE_URL=https://api.mystars.tg
# Required for automatic Telegram Stars & Premium fulfillment:
MYSTARS_API_KEY=
# Automatic status polling interval (ms, default 15000) and HTTP timeout (ms, default 15000):
MYSTARS_POLL_INTERVAL_MS=15000
MYSTARS_REQUEST_TIMEOUT_MS=15000
# Optional (NOT required and NOT used in Polling-only mode):
# MYSTARS_WEBHOOK_SECRET=
# MYSTARS_CALLBACK_URL=
TON_WALLET_ADDRESS=
